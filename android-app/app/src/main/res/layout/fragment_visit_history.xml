<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
             xmlns:tools="http://schemas.android.com/tools"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             tools:context=".VisitHistory">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:background="@color/fs_border"
            android:layout_height="match_parent">


        <androidx.appcompat.widget.Toolbar
                android:id="@+id/visit_history_toolbar"
                android:layout_width="0dp"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/purple_700"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                    android:id="@+id/visithistoryBackBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/fs_surface"
                    android:layout_gravity="start|center_vertical" />

            <TextView
                    android:id="@+id/check_in_toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visit History"
                    android:textColor="@color/fs_surface"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" tools:layout_editor_absoluteY="14dp"
                    tools:layout_editor_absoluteX="164dp"/>
        </androidx.appcompat.widget.Toolbar>

        <TextView
                android:id="@+id/visit_history_errorTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Failed to retrieve past visits"
                android:textColor="@color/fs_surface"
                android:visibility="invisible"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/visit_history_toolbar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/visit_history_locationTxt" />
        <TextView
                android:id="@+id/visit_history_locationTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Store Location"
                android:textColor="@color/fs_surface"
                android:textColorHint="@color/fs_text_secondary"
                android:layout_margin="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="60dp"
                app:layout_constraintTop_toBottomOf="@+id/visit_history_toolbar"/>

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/viewHistoryRecycleView"
                android:layout_width="411dp"
                android:layout_height="802dp"
                android:layout_margin="16dp"
                android:background="@color/fs_border"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_visit_history" app:layout_constraintHorizontal_bias="0.432"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="88dp" android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/visit_history_locationTxt"
                app:layout_constraintVertical_bias="0.0"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
