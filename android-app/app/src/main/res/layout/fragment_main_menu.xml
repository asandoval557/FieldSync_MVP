<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fs_background"
        android:paddingLeft="@dimen/fragment_horizontal_margin"
        android:paddingRight="@dimen/fragment_horizontal_margin"
        tools:context=".MainMenu">

    <!-- Logo -->
    <ImageView
            android:id="@+id/logoImage"
            android:layout_width="0dp"
            android:layout_height="180dp"
            app:srcCompat="@drawable/logo_new"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Vertical center guideline for 2-column layout -->
    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/mainMenuCenterGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

    <!-- ROW 1 -->

    <!-- CHECK IN (top-left) -->
    <Button
            android:id="@+id/main_menu_checkInBtn"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:text="@string/check_in_button"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:background="@drawable/button_rounded"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/logoImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/mainMenuCenterGuide" />

    <!-- PHOTO CAPTURE (top-right) -->
    <Button
            android:id="@+id/main_menu_photoCaptureBtn"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:text="Photo Capture"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:background="@drawable/button_rounded"
            android:layout_marginTop="50dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/logoImage"
            app:layout_constraintStart_toEndOf="@id/mainMenuCenterGuide"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- ROW 2 -->

    <!-- VISIT HISTORY (middle-left) -->
    <Button
            android:id="@+id/main_menu_visitHistoryBtn"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:text="Visit History"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:background="@drawable/button_rounded"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/main_menu_checkInBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/mainMenuCenterGuide" />

    <!-- VISIT NOTES (middle-right) -->
    <Button
            android:id="@+id/main_menu_visitNotesBtn"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:text="Visit Notes"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:background="@drawable/button_rounded"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/main_menu_photoCaptureBtn"
            app:layout_constraintStart_toEndOf="@id/mainMenuCenterGuide"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- ROW 3 -->

    <!-- STORE MANAGEMENT (bottom-left) -->
    <Button
            android:id="@+id/main_menu_storeManagementBtn"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:text="Store Management"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:background="@drawable/button_rounded"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/main_menu_visitHistoryBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/mainMenuCenterGuide" />

    <!-- LOGOUT (bottom-right) -->
    <Button
            android:id="@+id/main_menu_logoutBtn"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:text="Logout"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:background="@drawable/button_rounded"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/main_menu_visitNotesBtn"
            app:layout_constraintStart_toEndOf="@id/mainMenuCenterGuide"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


