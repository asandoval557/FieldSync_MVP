<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fs_background"
        android:paddingLeft="@dimen/fragment_horizontal_margin"
        android:paddingRight="@dimen/fragment_horizontal_margin"
        tools:context=".MainMenu">

    <!-- Logo -->
    <ImageView
            android:id="@+id/logoImage"
            android:layout_width="0dp"
            android:layout_height="180dp"
            app:srcCompat="@drawable/logo_new"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingBottom="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- CHECK IN -->
    <Button
            android:id="@+id/main_menu_checkInBtn"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:text="@string/check_in_button"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logoImage" />

    <!-- PHOTO CAPTURE -->
    <Button
            android:id="@+id/main_menu_photoCaptureBtn"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:text="Photo Capture"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_menu_checkInBtn" />

    <!-- VISIT HISTORY -->
    <Button
            android:id="@+id/main_menu_visitHistoryBtn"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:text="Visit History"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_menu_photoCaptureBtn" />

    <!-- STORE MANAGEMENT -->
    <Button
            android:id="@+id/main_menu_storeManagementBtn"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:text="Store Management"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_menu_visitHistoryBtn" />

    <!-- VISIT NOTES -->
    <Button
            android:id="@+id/main_menu_visitNotesBtn"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:text="Visit Notes"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_menu_storeManagementBtn" />

    <!-- LOGOUT -->
    <Button
            android:id="@+id/main_menu_logoutBtn"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:text="Logout"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_700"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_menu_visitNotesBtn"
            app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Apply vertical chain to all buttons -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/logoImage"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <!-- NOTE: Chain is automatically created because all buttons
             are connected top-to-bottom and share start/end constraints -->
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

