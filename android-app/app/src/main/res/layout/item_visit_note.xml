<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="4dp"
        android:elevation="1dp"
        android:padding="16dp">

    <!-- Note date -->
    <TextView
            android:id="@+id/visitNotes_noteDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Dec 6, 2025 at 8:23 AM" />

    <!-- Note body -->
    <TextView
            android:id="@+id/visitNotes_noteBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textColor="@android:color/black"
            tools:text="Spoke with store manager about inventory, merchandising, and next visit steps." />

    <!-- Divider line (matching other cards) -->
    <View
            android:id="@+id/visitNotes_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F0F0F0" />

</LinearLayout>
