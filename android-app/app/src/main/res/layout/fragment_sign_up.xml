<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/signUpRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/fs_border"
            tools:context=".ui.login.SignUpFragment">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <TextView
                android:id="@+id/titleSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create your account"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingBottom="16dp" />

        <EditText
                android:id="@+id/signUpUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username"
                android:textColor="@color/fs_text_primary"
                android:inputType="textPersonName"
                android:autofillHints="name"
                android:imeOptions="actionNext"
                android:paddingBottom="12dp" />


        <EditText
                android:id="@+id/signUpEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:textColor="@color/fs_text_primary"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext" />

        <EditText
                android:id="@+id/signUpPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password (min 6 chars)"
                android:textColor="@color/fs_text_primary"
                android:inputType="textPassword"
                android:imeOptions="actionNext"
                android:paddingTop="12dp" />

        <EditText
                android:id="@+id/signUpConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm password"
                android:textColor="@color/fs_text_primary"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:paddingTop="12dp" />

        <!-- Privacy Policy and Terms Checkboxes -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

            <CheckBox
                    android:id="@+id/privacyPolicyCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="I agree to the Privacy Policy"
                    android:textSize="14sp" />

            <TextView
                    android:id="@+id/privacyPolicyLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Privacy Policy"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:paddingStart="40dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true" />

            <CheckBox
                    android:id="@+id/termsConditionsCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="I agree to the Terms and Conditions"
                    android:textSize="14sp" />

            <TextView
                    android:id="@+id/termsConditionsLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Terms and Conditions"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:paddingStart="40dp"
                    android:clickable="true"
                    android:focusable="true" />

        </LinearLayout>

        <Button
                android:id="@+id/signUpButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create account"
                android:background="@color/purple_500"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="16dp"
                android:enabled="false" />

        <ProgressBar
                android:id="@+id/signUpLoading"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

        <TextView
                android:id="@+id/linkLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? Log in"
                android:textColor="?attr/colorPrimary"
                android:paddingTop="24dp" />
    </LinearLayout>
</ScrollView>